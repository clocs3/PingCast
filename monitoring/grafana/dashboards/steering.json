{
  "id": null,
  "title": "Steering Control",
  "tags": [
    "media",
    "steering",
    "control"
  ],
  "style": "dark",
  "timezone": "",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Current end-user route state from Redis control flags.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONPREM"
                },
                "1": {
                  "text": "STEERING ON"
                }
              }
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(control_steering_enabled{cluster=\"onprem\",namespace=\"ns-media-onprem\"} or vector(0))",
          "refId": "A"
        }
      ],
      "title": "Viewer Route",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Current steering status from Redis control flags.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF"
                },
                "1": {
                  "text": "ON"
                }
              }
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(control_steering_enabled{cluster=\"onprem\",namespace=\"ns-media-onprem\"} or vector(0))",
          "refId": "A"
        }
      ],
      "title": "Steering Status",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Most recent time the steering trigger action succeeded.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NEVER"
                }
              }
            }
          ],
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(control_last_steering_trigger_timestamp_seconds{cluster=\"onprem\",namespace=\"ns-media-onprem\"} or vector(0)) * 1000",
          "refId": "A"
        }
      ],
      "title": "Last Steering Trigger",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Most recent time the steering recover action succeeded.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NEVER"
                }
              }
            }
          ],
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(control_last_steering_recover_timestamp_seconds{cluster=\"onprem\",namespace=\"ns-media-onprem\"} or vector(0)) * 1000",
          "refId": "A"
        }
      ],
      "title": "Last Steering Recover",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Current on-prem active publisher count.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 2
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(active_publishers{cluster=\"onprem\",namespace=\"ns-media-onprem\"})",
          "refId": "A"
        }
      ],
      "title": "On-Prem Publishers",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Current on-prem pending ffmpeg count.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(ffmpeg_pending_streams{cluster=\"onprem\",namespace=\"ns-media-onprem\"})",
          "refId": "A"
        }
      ],
      "title": "Pending FFmpeg",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Current on-prem controller and ingest CPU.",
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{cluster=\"onprem\",namespace=\"ns-media-onprem\",pod=~\"stream-controller.*|nginx-rtmp.*\",container!=\"\",container!=\"POD\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "On-Prem CPU",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Current on-prem RTMP receive bandwidth.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{cluster=\"onprem\",namespace=\"ns-media-onprem\",pod=~\"nginx-rtmp.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "On-Prem RTMP RX",
      "type": "stat"
    },
    {
      "datasource": "Loki",
      "description": "Recent steering control events from stream-controller logs.",
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=\"ns-media-onprem\",app=\"stream-controller\"} |= \"\\\"event\\\":\\\"control_transition\\\"\" | json | service=\"steering\" | line_format \"{{.transition_kind}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Steering Event Log",
      "type": "logs"
    },
    {
      "datasource": "Prometheus",
      "description": "Running pods on the two on-prem HLS worker nodes.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 15
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "max by (instance, pod) (container_last_seen{cluster=\"onprem\",namespace=\"ns-media-onprem\",container!=\"\",container!=\"POD\",pod=~\"ffmpeg-.*|hls-router.*|nginx-hls.*\"}) > time() - 60",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Running Pods By Node",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "cluster": true,
              "container_runtime_version": true,
              "created_by_kind": true,
              "created_by_name": true,
              "host_ip": true,
              "job": true,
              "namespace": true,
              "pod_ip": true,
              "uid": true
            },
            "indexByName": {
              "instance": 0,
              "pod": 1
            },
            "renameByName": {
              "instance": "Node",
              "pod": "Running Pod"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "description": "Pending pods targeting the two on-prem HLS worker nodes require kube-state-metrics for names. Use Pending FFmpeg stat above for current waiting count.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "max by (pod) (kube_pod_status_phase{namespace=\"ns-media-onprem\",phase=\"Pending\",pod=~\"ffmpeg-.*|hls-router.*|nginx-hls.*|nginx-rtmp.*|stream-controller.*\"} == 1)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Pending Pods",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "cluster": true,
              "job": true,
              "namespace": true,
              "phase": true
            },
            "indexByName": {
              "pod": 0
            },
            "renameByName": {
              "pod": "Pending Pod"
            }
          }
        }
      ],
      "type": "table"
    }
  ]
}
